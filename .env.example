# Adhi Whale Terminal — environment variables (copy to .env for local runs; NEVER commit real values)
# Read-only & notifications only. Do not put exchange API keys, private keys or seed phrases anywhere.

# Optional Telegram notifications from the 24/7 recorder (GitHub Actions secrets with the same names)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Recorder
RUN_MINUTES=55
KEEP_DAYS=30

# Backtest (node backtest/run.cjs)
MONTHS=12
COINS=BTC,ETH,SOL,LINK,NEAR,INJ,PENDLE,ONDO,DOGE,AVAX,ARB,SUI,OP,AAVE,UNI

# Paid data adapters (recorder/adapters.cjs). Not integrated: leave empty unless you implement the adapter.
ONCHAIN_API_KEY=
ETF_API_KEY=
